# ============================================
# 环境变量模板
# 使用方法：复制本文件为 .env，再填写真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不要提交真实密钥到仓库
# 前端变量必须以 VITE_ 开头，否则无法通过 import.meta.env 读取
# 当前纯前端项目可不填写任何值，留空即可。
# ============================================

# 预留：后续如接入大模型 / 第三方接口，在此填写，仅保存在本地 .env
VITE_APP_TITLE=伴宠有方
# VITE_AI_API_KEY=your_api_key_here
# VITE_AI_BASE_URL=https://your-api-endpoint.example.com
